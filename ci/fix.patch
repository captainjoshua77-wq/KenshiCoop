 src/plugin/sync/Replicator.h            | 13 +++++++++
 src/plugin/sync/ReplicatorAuthority.cpp | 12 ++++++++
 src/plugin/sync/ReplicatorChannels.cpp  | 37 +++++++++++++++++++++++--
 src/plugin/sync/ReplicatorCore.cpp      |  1 +
 src/plugin/sync/ReplicatorDrive.cpp     |  4 +++
 5 files changed, 64 insertions(+), 3 deletions(-)

diff --git a/src/plugin/sync/Replicator.h b/src/plugin/sync/Replicator.h
index 55bc114..8c82157 100644
--- a/src/plugin/sync/Replicator.h
+++ b/src/plugin/sync/Replicator.h
@@ -1071,6 +1071,19 @@ private:
     // Last LOCAL hand reported for each wire key, so the [rekey] translation
     // line is emitted on change rather than every drive tick.
     std::map<Key, Key>        rekeyLogged_;
+    // Reverse of the [rekey] translation: LOCAL hand -> the wire key the peer
+    // streams (and lists in its census) for the same body. Stamped whenever the
+    // drive sees a driven body's local hand diverge from its wire key, and NOT
+    // pruned with drivenSeen_/canonicalOf_: a re-keyed body keeps its new local
+    // hand after the stream moves on, which is exactly when the wide census
+    // pass needs the translation. Without it that pass looks the LOCAL hand up
+    // in a census keyed by the peer's hand, misses, culls the body, the next
+    // drive sample restores it (proxy/driven exemption), and the cycle repeats.
+    // Field session 2026-10-10 (cellAuth=0, two players in one town): 1275 of
+    // the join's 1303 wide culls in 17 min hit 9 re-keyed bodies, one 'Shek
+    // Retainer' 702 times. Hands are serial-checked, so a stale entry can only
+    // ever match the body it was stamped for. Cleared with the session.
+    std::map<Key, Key>        wireOfLocal_;
     // Step-5 hysteresis: consecutive-frame counters per hand so a brief stream
     // hiccup doesn't suppress (needs ~1 s unstreamed) and a boundary NPC doesn't
     // flicker back (needs ~2 s streamed dwell to restore). Spike 18: the hard
diff --git a/src/plugin/sync/ReplicatorAuthority.cpp b/src/plugin/sync/ReplicatorAuthority.cpp
index fe82227..bc3aca7 100644
--- a/src/plugin/sync/ReplicatorAuthority.cpp
+++ b/src/plugin/sync/ReplicatorAuthority.cpp
@@ -508,6 +508,18 @@ void Replicator::enforceHostAuthority(GameWorld* gw, u32 localId) {
             if (driven && suppressed_.find(k) == suppressed_.end()) continue;
             bool exists = censusHands_.find(k) != censusHands_.end() ||
                           keep.find(k) != keep.end() || driven;
+            if (!exists) {
+                // A RE-KEYED body (a fight start separateIntoMyOwnSquad's our
+                // copy into a fresh local container) is listed in the census
+                // under the peer's wire key, never under the local hand we just
+                // looked up. Absence of the local hand is then not absence of
+                // the body - consult the translation the drive recorded.
+                std::map<Key, Key>::const_iterator wk = wireOfLocal_.find(k);
+                if (wk != wireOfLocal_.end() &&
+                    (censusHands_.find(wk->second) != censusHands_.end() ||
+                     keep.find(wk->second) != keep.end()))
+                    exists = true;
+            }
             std::map<Key, Character*>::iterator s = suppressed_.find(k);
             AuthCount& ac = authCount_[k];
             // Dormancy, same as the near pass - and this is where it matters
diff --git a/src/plugin/sync/ReplicatorChannels.cpp b/src/plugin/sync/ReplicatorChannels.cpp
index 98c3c8c..985de11 100644
--- a/src/plugin/sync/ReplicatorChannels.cpp
+++ b/src/plugin/sync/ReplicatorChannels.cpp
@@ -833,7 +833,20 @@ void Replicator::publishDoors(const SyncContext& ctx) {
         pkt.type    = (u8)PKT_DOOR;
         pkt.ownerId = ownerId;
         pkt.seq     = doorSeqOut_++;
-        for (unsigned int h = 0; h < 5; ++h) pkt.hand[h] = r.hand[h];
+        // A building that IS a door (a standalone placed door or gate, e.g.
+        // Forgotten Buildings' 'Storm House Door E') has no parent, so the
+        // protocol-28 partition above never claims it and it streams here. If
+        // this copy is a proxy WE minted from the peer's PLACE, our runtime
+        // hand names nothing on the placer: express it in the placer's key
+        // space, which on the placer is simply its own hand.
+        std::map<Key, Key>::const_iterator mk = mintByLocal_.find(k);
+        if (mk != mintByLocal_.end()) {
+            pkt.hand[0] = mk->second.t;  pkt.hand[1] = mk->second.c;
+            pkt.hand[2] = mk->second.cs; pkt.hand[3] = mk->second.i;
+            pkt.hand[4] = mk->second.s;
+        } else {
+            for (unsigned int h = 0; h < 5; ++h) pkt.hand[h] = r.hand[h];
+        }
         pkt.open    = (u8)(r.open ? 1 : 0);
         pkt.locked  = (u8)(r.locked ? 1 : 0);
         net.queueDoor(pkt);
@@ -865,13 +878,31 @@ void Replicator::applyDoors(const SyncContext& ctx) {
         // write causes must not be re-detected as ours next sample.
         dr.knownOpen = (int)p.open; dr.knownLocked = (int)p.locked;
         dr.seeded = true;
+        // The mirror of publishDoors' translation: a placed building that IS a
+        // door arrives under the PLACER's hand, which on this client names
+        // nothing - our copy is the proxy minted from the PLACE under another
+        // runtime hand. Resolve it through the build map (field session
+        // 2026-10-10: the placer's '[door] SEND open=1' for a placed door had
+        // no RECV at all on the join, and the door stayed shut there).
+        const unsigned int* useHand = p.hand;
+        std::map<Key, PeerBuild>::const_iterator pbit = peerBuilds_.find(k);
+        if (pbit != peerBuilds_.end() && pbit->second.minted &&
+            !pbit->second.removed) {
+            useHand = pbit->second.localHand;
+            // Same echo guard, keyed the way OUR sampler sees this door.
+            Key lk; lk.t = useHand[0]; lk.c = useHand[1]; lk.cs = useHand[2];
+            lk.i = useHand[3]; lk.s = useHand[4];
+            DoorRow& lr = doorRows_[lk];
+            lr.knownOpen = (int)p.open; lr.knownLocked = (int)p.locked;
+            lr.seeded = true;
+        }
         engine::DoorRead cur;
-        if (!engine::readDoorByHand(p.hand, &cur))
+        if (!engine::readDoorByHand(useHand, &cur))
             continue; // out-of-interest or runtime door - accepted edge
         bool lockMoves = cur.hasLock && (cur.locked != (int)p.locked);
         if (cur.open == (int)p.open && !lockMoves)
             continue; // already converged (resend or echo)
-        bool ok = engine::writeDoorByHand(p.hand, (int)p.open,
+        bool ok = engine::writeDoorByHand(useHand, (int)p.open,
                                           cur.hasLock ? (int)p.locked : -1, 0);
         char b[176];
         _snprintf(b, sizeof(b) - 1,
diff --git a/src/plugin/sync/ReplicatorCore.cpp b/src/plugin/sync/ReplicatorCore.cpp
