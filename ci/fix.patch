+                wireOfLocal_[lk] = it->first;
                 std::map<Key, Key>::iterator rk = rekeyLogged_.find(it->first);
                 if (rk == rekeyLogged_.end() ||
                     (rk->second < lk) || (lk < rk->second)) {
