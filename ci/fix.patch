--- a/src/plugin/sync/ReplicatorDrive.cpp
+++ b/src/plugin/sync/ReplicatorDrive.cpp
@@ -294,6 +294,10 @@ void Replicator::applyTargets(GameWorld* gw) {
                  lh[2] != it->first.cs)) {
                 Key lk; lk.t = lh[0]; lk.c = lh[1]; lk.cs = lh[2];
                 lk.i = lh[3]; lk.s = lh[4];
+                // Keep the reverse translation for the wide census pass, which
